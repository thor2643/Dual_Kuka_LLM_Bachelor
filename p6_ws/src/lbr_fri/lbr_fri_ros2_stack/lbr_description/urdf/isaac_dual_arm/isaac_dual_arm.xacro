    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
	<mesh filename="package://lbr_description/meshes/table/collision/iiwa7_table_collision.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- the wooden laser cut camera mount
  <link name="cam_mount">
    <visual>
      <origin rpy="0 0 0" xyz="0.096012 0.03490 -0.059336"/>
      <geometry>
	<mesh filename="package://lbr_description/meshes/camera_mount/Camera_Mount_V2_v2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wood"/>
    </visual>
  </link>
  -->
  <!-- 3f gripper adapter / mounting plate -->
  <link name="gripper_mounting_plate">
	<visual>
	    <origin xyz="0.045 -0.045 0" rpy="0 0 0"/>
	    <geometry>
	        <mesh filename="package://lbr_description/meshes/gripper_mounting_plate/gripper_mounting_plate.stl" scale="0.001 0.001 0.001"/>
	    </geometry>
	    <material name="steel_satin"/>
	</visual>

	<collision>
	    <origin xyz="0.045 -0.045 0" rpy="0 0 0"/>
	    <geometry>
	        <mesh filename="package://lbr_description/meshes/gripper_mounting_plate/gripper_mounting_plate.stl" scale="0.001 0.001 0.001"/>
	    </geometry>
	</collision>
  </link>    
  <!-- camera arm mount -->
  <link name="camera_arm_mount">
	<visual>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry>
	        <mesh filename="package://lbr_description/meshes/camera_arm_mount/Mount_realsense_camera_Default.stl" scale="0.001 0.001 0.001"/>
	    </geometry>
	    <material name="steel_satin"/>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry>
	        <mesh ilename="package://lbr_description/meshes/camera_arm_mount/Mount_realsense_camera_Default.stl"  scale="0.001 0.001 0.001"/>
	    </geometry>
	</collision>
  </link>    

  <!--joint between world and table-->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="table"/>
  </joint>
  <!--joint between table and wooden camera mount
  <joint name="cam_table_joint" type="fixed">
    <parent link="table"/>
    <child link="cam_mount"/>
    <origin rpy="1.57079633 0 0" xyz="0.489819 0.84691 1.428"/>
  </joint>
  -->
  <!--joint between table and right iiwa7 -->
  <joint name="mount_right" type="fixed">
    <parent link="table"/>
    <child link="right_link_0"/>
    <origin rpy="0 0 -0.785398163" xyz="0.145181 0.79431 0.815"/>
  </joint>
  <!-- joint between right iiwa7 and 3f gripper-->
    <joint name="ee_mount" type="fixed">    
	<parent link="right_link_ee" />
	<child link="gripper_mounting_plate" />
	<origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  <!-- joint between right iiwa7 and 3f gripper-->
    <joint name="adapter_mount" type="fixed">    
	<parent link="gripper_mounting_plate" />
	<child link="3f_palm" />
	<origin xyz="0 0 0.0745" rpy="1.57079633 0 -1.57079633"/>
    </joint>
  <!-- joint between left arm and table -->
  <joint name="mount_left" type="fixed">
    <parent link="table"/>
    <child link="left_link_0"/>
    <origin rpy="0 0 -2.35619449 " xyz="0.795181 0.79431 0.815"/>
  </joint>
  <!-- joint between left iiwa7 and camera arm mount-->
  <joint name="left_ee_cam" type="fixed">
    <parent link="left_link_ee"/>
    <child link="camera_arm_mount"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- joint between camera arm mount and 2f gripper-->
  <joint name="left_ee_mount" type="fixed">
    <parent link="camera_arm_mount"/>
    <child link="left_robotiq_arg2f_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.012"/>
  </joint>
  
  <!-- joint between left arm ee and 2f gripper-->
  <joint name="2f_ee_tool0" type="fixed">
    <parent link="left_link_ee"/>
    <child link="2f_tool0"/>
    <origin rpy="0 3.14 0" xyz="0 0 0.165"/>
  </joint>
</robot>
