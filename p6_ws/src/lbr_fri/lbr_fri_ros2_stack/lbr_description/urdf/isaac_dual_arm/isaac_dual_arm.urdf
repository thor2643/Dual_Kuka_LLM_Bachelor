    <parent link="right_link_ee"/>
    <child link="gripper_mounting_plate"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- joint between right iiwa7 and 3f gripper-->
  <joint name="adapter_mount" type="fixed">
    <parent link="gripper_mounting_plate"/>
    <child link="a_3f_palm"/>
    <origin rpy="1.57079633 0 -1.57079633" xyz="0 0 0.0745"/>
  </joint>
  <!-- joint between 3f gripper and 3f tool0-->
  <joint name="a_3f_palm_tool0" type="fixed">
    <parent link="a_3f_palm"/>
    <child link="a_3f_tool0"/>
    <origin rpy="0 -1.5707 1.5707" xyz="0.0 0.15 0"/>
  </joint>
  <!-- JOINTS FOR LEFT ARM AND 2F GRIPPER -->
  <!-- joint between left arm and table -->
  <joint name="mount_left" type="fixed">
    <parent link="table_top"/>
    <child link="left_link_0"/>
    <origin rpy="0 0 -2.35619449 " xyz="0.795181 0.79431 0.815"/>
  </joint>
  <!-- joint between left iiwa7 and camera arm mount-->
  <joint name="left_ee_cam" type="fixed">
    <parent link="left_link_ee"/>
    <child link="camera_arm_mount"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- joint between camera arm mount and 2f gripper
  <joint name="left_ee_mount" type="fixed">
    <parent link="camera_arm_mount"/>
    <child link="left_robotiq_arg2f_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.012"/>
  </joint>
  -->
  <!-- joint between camara arm mount and 2f_tool0-->
  <joint name="2f_ee_tool0" type="fixed">
    <parent link="camera_arm_mount"/>
    <child link="2f_tool0"/>
    <origin rpy="0 3.14 0" xyz="0 0 0.165"/>
  </joint>
</robot>
