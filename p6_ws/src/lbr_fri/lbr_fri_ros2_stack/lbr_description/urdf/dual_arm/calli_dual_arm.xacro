      <origin rpy="0 0 0" xyz="-1.181 0 0"/>
      <geometry>
	<mesh filename="package://lbr_description/meshes/table/collision/Side_box.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="2f_tool0"/>
  <link name="3f_tool0"/>
 
  <link name="left_calli_tip">
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0"/>
      <geometry>
	<mesh filename="package://lbr_description/meshes/calibration_tip/calli_tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <link name="right_calli_tip">
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0"/>
      <geometry>
	<mesh filename="package://lbr_description/meshes/calibration_tip/calli_tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
 
 
  <!-- TABLE AND SIDE WALL JOINTS TO TABLE-->
  <!--Joint between world and table-->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="table_top"/>
  </joint>
  <joint name="left_side_wall_joint" type="fixed">
    <parent link="world"/>
    <child link="left_side_wall"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="right_side_wall_joint" type="fixed">
    <parent link="world"/>
    <child link="right_side_wall"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="back_wall_joint" type="fixed">
    <parent link="world"/>
    <child link="back_wall"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="left_box_joint" type="fixed">
    <parent link="world"/>
    <child link="left_box"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="right_box_joint" type="fixed">
    <parent link="world"/>
    <child link="right_box"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- JOINTS FOR RIGHT ARM AND 3F GRIPPER -->
  <!--Joint between table and right iiwa7 -->
  <joint name="mount_right" type="fixed">
    <parent link="table_top"/>
    <child link="right_link_0"/>
    <origin rpy="0 0 -0.785398163" xyz="0.145181 0.79431 0.815"/>
  </joint>
  <!-- joint between 3f gripper and 3f tool0-->
  <joint name="right_ee_tool0" type="fixed">
    <parent link="right_link_ee"/>
    <child link="3f_tool0"/>
    <origin rpy="0 -1.5707 1.5707" xyz="0.0 0 0.05"/>

  </joint>
  <joint name="right_ee_tip" type="fixed">
    <parent link="right_link_ee"/>
    <child link="right_calli_tip"/>
    <origin rpy="0 0 0" xyz="0.0 0 0"/>
  </joint>

  <!-- JOINTS FOR LEFT ARM AND 2F GRIPPER -->
  <!-- joint between left arm and table -->
  <joint name="mount_left" type="fixed">
    <parent link="table_top"/>
    <child link="left_link_0"/>
    <origin rpy="0 0 -2.35619449 " xyz="0.795181 0.79431 0.815"/>
  </joint>

  <!-- joint between camara arm mount and 2f_tool0-->
  <joint name="left_ee_tool0" type="fixed">
    <parent link="left_link_ee"/>
    <child link="2f_tool0"/>
    <origin rpy="0 3.14 0" xyz="0 0 0.05"/>
  </joint>

  <joint name="left_ee_tip" type="fixed">
    <parent link="left_link_ee"/>
    <child link="left_calli_tip"/>
    <origin rpy="0 0 0" xyz="0.0 0 0"/>
  </joint>
</robot>
