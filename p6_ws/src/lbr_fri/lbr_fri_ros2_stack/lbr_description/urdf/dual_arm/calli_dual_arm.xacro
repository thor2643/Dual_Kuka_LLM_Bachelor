<?xml version="1.0"?>

<!-- top level -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="isaac_dual_arm">
  <!-- Setup of Hardware & Joints for kuka interface -->
  <xacro:include filename="$(find dual_arm_moveit_config)/config/dual_arm.ros2_control.xacro"/>

  <!-- Intel realsense -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <!-- MATERIAL LIST -->
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="steel_satin">
    <color rgba="0.6274509803921569 0.6274509803921569 0.6274509803921569 1"/>
  </material>
  <material name="wood">
    <color rgba="0.588235294 0.375 0.1 1"/>
  </material>
  <material name="white">
    <color rgba="0.8 0.8 0.8 1"/>
  </material>
  <material name="gray">
	<color rgba="1 0 0 1"/>
  </material>

  <!-- CAMERA MOUNT-->
  <xacro:sensor_d435i parent="base_link" use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d435i>


  <!-- Links & Joints for the Right Arm -->
  <link name="right_link_0">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.012857 0.0 0.069964"/>
